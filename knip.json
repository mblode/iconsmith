{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mkfifo"],
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/verify.mjs", "scripts/verify.test.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/iconsmith": {
      "entry": [
        "scripts/calibrate.ts",
        "scripts/extract-central-metadata.ts",
        "scripts/judge-gate.ts",
        "scripts/library-audit-cli.ts",
        "scripts/library-replay-cli.ts",
        "scripts/quality-audit.ts",
        "scripts/review-proof.ts",
        "scripts/stress-registration.ts",
        "scripts/vocabulary-sheet.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
    }
  }
}
