iconsmith:test: - npm run --silent iconsmith -- lint cloud-check.svg --keyline wide
iconsmith:test: - npm run --silent iconsmith -- --output json lint cloud-check.svg   # machine-readable
iconsmith:test: - npm run --silent iconsmith -- new database -o database.svg
iconsmith:test: + npx iconsmith draw cloud-check.icon > cloud-check.svg
iconsmith:test: + npx iconsmith lint cloud-check.svg --keyline wide
iconsmith:test: + npx iconsmith --output json lint cloud-check.svg   # machine-readable
