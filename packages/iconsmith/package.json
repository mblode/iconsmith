{
  "name": "iconsmith",
  "private": true,
  "description": "Icon generation pipeline: extract parts from an icon set, compose new icons in a constrained DSL, conform them to a house spec.",
  "keywords": [
    "ai",
    "codegen",
    "design-system",
    "icons",
    "svg"
  ],
  "homepage": "https://github.com/mblode/iconsmith#readme",
  "bugs": {
    "url": "https://github.com/mblode/iconsmith/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/iconsmith.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js",
      "default": "./dist/spec.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "check": "ultracite check && npm run check:boundaries",
    "fix": "ultracite fix",
    "check:boundaries": "node scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.54",
    "ai": "^7.0.66",
    "commander": "^15.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11"
  }
}
