{
  "name": "iconsmith",
  "version": "0.1.0",
  "description": "Create SVG icons with your coding agent, bundled Blode references, exact checks and native previews.",
  "keywords": [
    "ai",
    "codegen",
    "design-system",
    "icons",
    "svg"
  ],
  "homepage": "https://github.com/mblode/iconsmith#readme",
  "bugs": {
    "url": "https://github.com/mblode/iconsmith/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/iconsmith.git"
  },
  "bin": {
    "iconsmith": "dist-agent/cli.js"
  },
  "files": [
    "dist-agent/",
    "SKILL.md",
    "references/",
    "library/blode-icons/"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "check": "ultracite check && npm run check:boundaries",
    "fix": "ultracite fix",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "paper": "0.12.18",
    "pathkit-wasm": "1.0.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.54",
    "@ai-sdk/provider": "^4.0.7",
    "@types/node": "^24.13.3",
    "ai": "^7.0.66",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "run": "^2.0.3",
    "tsdown": "^0.22.4",
    "tsx": "4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11"
  }
}
