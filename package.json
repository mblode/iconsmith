{
  "name": "iconsmith-monorepo",
  "private": true,
  "workspaces": [
    "packages/iconsmith"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:local": "npm run build --workspace iconsmith",
    "iconsmith": "node packages/iconsmith/dist/cli.js",
    "generate:local": "node --import tsx packages/iconsmith/scripts/local-generate.ts",
    "dev": "turbo dev",
    "test": "node --test scripts/verify.test.mjs && turbo test",
    "typecheck": "turbo typecheck",
    "check": "npm run check:foundry && npm run check:dead && turbo check",
    "check:boundaries": "turbo check:boundaries",
    "fix": "turbo fix",
    "prepare": "lefthook install || true",
    "check:foundry": "node --check scripts/verify.mjs && node --check scripts/verify.test.mjs && node packages/iconsmith/scripts/check-foundry-config.ts",
    "verify": "node scripts/verify.mjs",
    "check:dead": "knip"
  },
  "devDependencies": {
    "knip": "6.35.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "tsx": "4.23.13",
    "turbo": "^2",
    "ultracite": "^7.10.5"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "npm@11.19.0"
}
