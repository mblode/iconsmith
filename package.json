{
  "name": "iconsmith-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "check": "turbo check",
    "check:boundaries": "turbo check:boundaries",
    "fix": "turbo fix",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "turbo": "^2",
    "ultracite": "^7.10.5"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "npm@11.19.0"
}
