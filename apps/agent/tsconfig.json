{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "**/*.test.ts",
    // Run directly by `node --experimental-strip-types`, which requires the
    // explicit `.ts` extension that `tsc` rejects. Same split as apps/web.
    "scripts/eve-contamination.ts"
  ]
}
