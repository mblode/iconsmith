{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // The lint configs import oxlint/oxfmt/ultracite, which are declared once at
  // the workspace root. A Vercel build scoped to this app installs only this
  // app's dependencies, so type-checking them here fails the build on tooling
  // that never ships. oxlint validates its own config at check time anyway.
  "exclude": [
    "node_modules",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "**/*.test.ts",
    "scripts/prefix-eve-vercel-routes.ts"
  ]
}
